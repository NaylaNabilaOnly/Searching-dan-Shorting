#Binary Search
def binary_search(arr, target):
    left = 0
    right = len(arr) -1

    while left <= right:
        mid = (left + right) // 2
        if arr[mid] == target:
            return mid
        elif target < arr[mid]:
            right = mid -1 
        else:
            left = mid + 1
    return -1

data = [2, 4, 6, 8, 10]
target = 8

hasil = binary_search(data, target)
if hasil != -1:
    print(f"angka {target} ada di indeks {hasil}")
else:
    print("tidak di temukan")

