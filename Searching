
#Linearing Search
def linear_search(arr, target):
    for i in range(len(arr)):
        if arr[i] == target:
            return i
    return -1

data = [12, 7, 25, 9, 15]
target = 9

hasil = linear_search(data, target)

if hasil != -1:
    print(f"angka {target} ada di indeks {hasil}")
else:
    print("tidak di temukan")

#Binary Search
def binary_search(arr, target):
    left = 0
    right = len(arr) -1

    while left <= right:
        mid = (left + right) // 2
        if arr[mid] == target:
            return mid
        elif target < arr[mid]:
            right = mid -1 
        else:
            left = mid + 1
    return -1

data = [10, 20, 30, 40, 50]
target = 40

hasil = binary_search(data, target)
if hasil != -1:
    print(f"angka {target} ada di indeks {hasil}")
else:
    print("tidak di temukan")

