
#Linearing Search
def linear_search(arr, target):
    for i in range(len(arr)):
        if arr[i] == target:
            return i
    return -1

data = [12, 7, 25, 9, 15]
target = 9

hasil = linear_search(data, target)

if hasil != -1:
    print(f"angka {target} ada di indeks {hasil}")
else:
    print("tidak di temukan")

#Binary Search
def binary_search(arr, target):
    left = 0
    right = len(arr) -1

    while left <= right:
        mid = (left + right) // 2
        if arr[mid] == target:
            return mid
        elif target < arr[mid]:
            right = mid -1 
        else:
            left = mid + 1
    return -1

data = [10, 20, 30, 40, 50]
target = 40

hasil = binary_search(data, target)
if hasil != -1:
    print(f"angka {target} ada di indeks {hasil}")
else:
    print("tidak di temukan")

#naive string matching
def naive_string_matching(text, pattern):
    n = len(text)
    m = len(pattern)
    hasil_temuan = []
    for i in range(n - m + 1):
        if text[i : i + m] == pattern:
            hasil_temuan.append(i)
            print(f"Pattern '{pattern}' ditemukan pada indeks ke-{i}")

    return hasil_temuan

teks_input = "DATA STRUKTUR DATA"
pola_cari = "DATA"

print(f"Text: {teks_input}")
print(f"Pattern: {pola_cari}\n")

indeks = naive_string_matching(teks_input, pola_cari)

if not indeks:
    print("Pattern tidak ditemukan.")
else:
    print(f"\nTotal ditemukan: {len(indeks)} kali.")

# KMP [Knuth-Morris-Pratt]
def compute_lps(pattern):
    n = len(pattern)
    lps = [0] * n
    length = 0  
    i = 1

    while i < n:
        if pattern[i] == pattern[length]:
            length += 1
            lps[i] = length
            i += 1
        else:
            if length != 0:
                length = lps[length - 1]
            else:
                lps[i] = 0
                i += 1
    return lps

pattern = "ABABCABAB"
print("Pattern:", pattern)
print("LPS Array:", compute_lps(pattern))


